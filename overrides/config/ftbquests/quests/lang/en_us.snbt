	quest.7CA4EAFB15648550.quest_subtitle: "Mutation"
	quest.7CB9C6FEAF45F3AD.title: "Immersive Aircrafts"
	quest.7CF99DCD35D03C09.quest_desc: [
		"- &nUsage&r"
		""
		"&bMulch&r can be applied to a &bBerry Tree&r one at a time. It can be removed by interacting with the tree using a shovel or by destroying the tree."
		""
		"- &nMulch Types&r"
		""
		"&bMulch&r is an item used to craft various types of &bMulch&r. It serves as the fundamental component for creating &bMulch&r used to apply modifiers to &bberry trees&r and for mutating &bRevival Herbs&r."
	]
	quest.7CF99DCD35D03C09.quest_subtitle: "Click to Learn More!"
	quest.7D00E61A7EE5C5C9.quest_desc: ["Combee's and Vespiquen can honey up some Saccharine Leaves.  Make sure to have some flowers and Saccharine Trees around for them"]
