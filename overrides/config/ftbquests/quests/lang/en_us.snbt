	quest.7B9425B16370CCD6.quest_desc: [
		"Use rotational force to &bGenerate&r blocks. Tuff, Dacite, Granite. You name it. Sounds pretty good huh? "
		""
		"There are various blocks this extruder can produce. "
		""
		"Check EMI search (&7EMI&r) for recipes and their needed setups.  You can do this by either &aright-clicking&r the Mechanical Extruder in your inventory or &chover over it&r and press '&2U&r'"
		""
		"&6Mechanical Extruder&r can be crafted with:"
		"3x &bGlass"
		"1x &bShaft"
		"1x &bAndesite Casing"
		""
		"&aPondering is recommended."
	]
	quest.7B9425B16370CCD6.quest_subtitle: "Extrusion Bonk Technology"
	quest.7BB0C6C34664CDBF.quest_desc: [
		"The &bLightroom&r needs some material to process and create your photos. "
		""
		"&6Gather the following: "
		"- &bPaper"
		"- &bCyan Dye"
		"- &bMagenta Dye"
		"- &bYellow Dye"
		"- &bBlack Dye"
		""
		"Put these items in the slots in the Lightroom. &oOn to the next step"
	]
	quest.7BB0C6C34664CDBF.quest_subtitle: "Printer Cartridges: Expensive"
	quest.7BB0C6C34664CDBF.title: "Step 1: Prepping the Lightroom"
	quest.7BC075BF0EBC836C.quest_desc: [
		"Rotom love hanging around appliances. Who'd a thought"
		""
		"Redstone also influences their spawns"
	]
	quest.7BC075BF0EBC836C.quest_subtitle: "Appliance Overload"
	quest.7BC5E08F11DC0B0F.quest_desc: [
		"The classic Oran Berry.  Often found in plains and forests.  "
		""
		"Make sure have room to carry lots of them"
	]
	quest.7BC5E08F11DC0B0F.quest_subtitle: "&bTemperate"
	quest.7BD5086547F46FD1.quest_subtitle: "The Dye Trader"
	quest.7BF848EF09142D32.quest_desc: [
		"&6Mechanical Belts&r require at least 2 &bShafts&r."
		""
		"Right-click the first shaft, then the second to place the &6Belt&r. This only consumes 1 &6Mechanical Belt&r, no matter the length."
		""
		"Both &bShafts&r must face the same direction."
		""
		"&6Mechanical Belts&r can be crafted with:"
		""
		"6x &bDried Kelp&r"
	]
	quest.7BF848EF09142D32.quest_subtitle: "Move those items!"
	quest.7C43FDC9F76C0BBC.quest_desc: ["Not So Mysterious.  Craft a press package for your fellow AE2 friends to get them jump started"]
	quest.7C43FDC9F76C0BBC.quest_subtitle: "No meteroite needed!"
	quest.7C8F5639312A41A8.quest_desc: [
